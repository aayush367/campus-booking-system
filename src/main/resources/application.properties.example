spring.application.name=campus-booking-system

spring.datasource.url=jdbc:mysql://localhost:3306/campus_booking_system?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Australia/Sydney
spring.datasource.username=campus_user
spring.datasource.password=your_password_here
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

spring.thymeleaf.cache=false
